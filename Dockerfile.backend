FROM docker.io/library/node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

RUN apk add --no-cache \
    ca-certificates \
    ffmpeg \
    yt-dlp

WORKDIR /var/www/html

ENV NODE_ENV=production
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV YOUPLAYER_SPOTIFY_BROWSER_ENABLED=false

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY --chown=node:node server/ ./server/
COPY --chown=node:node client-utils.js ./client-utils.js
# Playlists are mounted at runtime and must not be embedded in release images.

RUN mkdir -p musiq local_song playlists /var/lib/youplayer \
    && chown node:node musiq local_song playlists /var/lib/youplayer

ARG YOUPLAYER_BUILD_COMMIT=unknown
ENV YOUPLAYER_BUILD_COMMIT=$YOUPLAYER_BUILD_COMMIT

USER node

EXPOSE 3000

CMD ["npm", "start"]
