# Exemples descriptifs uniquement : remplacer les indications par tes valeurs dans .env.
# Copier en .env (permissions 0600). Ne pas utiliser ces textes comme configuration.
# Pour une integration facultative non utilisee, laisser sa valeur vide dans .env.
# Aucun identifiant, mot de passe ou secret reel n'est fourni.
COMPOSE_PROJECT_NAME="Nom du projet Compose : youplayer-server pour les outils fournis"
YOUPLAYER_ADMIN_PSEUDO="Pseudo du premier compte administrateur"
YOUPLAYER_ADMIN_PASSWORD="CHANGE_ME : MDP de 12 caracteres minimum"
YOUPLAYER_SESSION_SECRET="CHANGE_ME : secret aleatoire de 32 caracteres minimum pour proteger les sessions"
YOUPLAYER_YOUTUBE_API_KEY="Cle API YouTube Data API v3 obtenue dans Google Cloud (facultatif)"
YOUPLAYER_SPOTIFY_TOKEN_SECRET="CHANGE_ME : secret aleatoire de 32 caracteres minimum, distinct du secret de session, pour chiffrer les jetons Spotify"
YOUPLAYER_SPOTIFY_CLIENT_ID="Client ID de ton application dans Spotify Developer Dashboard (OAuth facultatif)"
YOUPLAYER_SPOTIFY_CLIENT_SECRET="Client Secret de cette meme application Spotify (OAuth facultatif)"
YOUPLAYER_SPOTIFY_REDIRECT_URI="URL HTTPS de retour OAuth : https://ton-domaine/auth/spotify/callback, a enregistrer dans Spotify"
YOUPLAYER_SPOTIFY_SCOPES="Permissions OAuth separees par des espaces : user-read-private playlist-read-private playlist-read-collaborative"
YOUPLAYER_SPOTIFY_WEB_USERNAME="Identifiant du compte Spotify pour le diagnostic credentials-headless uniquement (facultatif)"
YOUPLAYER_SPOTIFY_WEB_PASSWORD="MDP du compte Spotify utilise pour ce diagnostic (facultatif)"
YOUPLAYER_LOG_LEVEL="Niveau des journaux : debug, info, warn, error ou silent"
YOUPLAYER_SESSION_MAX_AGE_MS="Duree de session en millisecondes : 259200000 correspond a 3 jours"
FIRST_TRACK_SPECIAL_STREAM="true pour activer le flux temporaire prive du premier titre, false pour le desactiver"
FIRST_TRACK_SPECIAL_STREAM_NEXT="true pour autoriser Suivant pendant ce flux, false pour le desactiver"
